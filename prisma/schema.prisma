generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid(2))
  email    String  @unique
  password String
  name     String
  role     Role    @default(USER)
  timezone String  @default("UTC") // NOVO - IANA (ex:"America/São_Paulo)
  habits   Habit[]
}

model Habit {
  id          String   @id @default(cuid(2))
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
  graceFills  GraceFill[]

  longestStreak   Int @default(0)
  longestStreakStartDate DateTime? @db.Date

  // grace period de streak ("streak freeze"): saldo por hábito, repõe
  // +1 por mês (calendário fixo, todo dia 1, em UTC) até um teto de 3.
  graceTokens          Int      @default(1)
  graceTokensUpdatedAt DateTime @default(now())
}


model HabitLog{
  id    String  @id @default(cuid(2))
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  checkedAt DateTime @default(now())   // instante bruto em UTC
  date      DateTime @db.Date          // dia calendário, congelado no timezone do usuário no momento da escrita

  @@index([habitId, date])

}

// dia "perdoado" por um token de grace period — não é um check-in real,
// é uma marcação de que um gap de 1 dia foi coberto por um token. Fica
// numa tabela separada (não em HabitLog) pra HabitLog continuar
// significando só "o usuário fez check-in nesse dia". Ver
// docs/explain/DECISOES-NAO-IMPLEMENTADAS.md.
model GraceFill {
  id      String @id @default(cuid(2))
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  @@unique([habitId, date])
}

enum Role {
  USER
  ADMIN
}


